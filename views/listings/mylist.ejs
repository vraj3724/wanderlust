<% layout("/layouts/boilerplate") %>
<body>
    <div class="px-3 px-sm-4 px-md-5 py-2">
    <h3>Below are all the listings</h3>
    <div class="row row-cols-xxl-6 row-cols-xl-5 row-cols-lg-4 row-cols-md-3 row-cols-sm-2 row-cols-1 g-2">
        <% for( let listings of listing ) { %>
            <a href="/listings/<%= listings._id %>" class="listing-links">
                <div class="card col listing-card">
                        <img src="<%= listings.image.url %>" 
                        class="card-img-top" 
                        alt="listing_img" 
                        style="height: 15rem;">

                         <div class="card-img-overlay"></div>

                        <div class="card-body mt-2">
                            <h5 class="card-title" style="font-size: 18px; font-weight: 700; margin-bottom: 1px;"><%= listings.shortDescription %></h5>
                            <p class="card-desc mb-1">
                            <%= listings.availability?.start 
                            ? listings.availability.start.toLocaleDateString("en-GB", { day: "numeric", month: "short" }) 
                            : "N/A" %> 
                            - 
                            <%= listings.availability?.end 
                            ? listings.availability.end.toLocaleDateString("en-GB", { day: "numeric", month: "short" }) 
                            : "N/A" %>
                            </p>
                            <p class="card-price">£ <%= listings.price %> per night</p>
                        </div>
                </div>
            </a>
            <% } %>
    </div>
</div>
</body>
