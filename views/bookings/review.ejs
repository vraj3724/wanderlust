<% layout("/layouts/boilerplate") %>

<script>
    const mapToken = "<%= mapToken %>";
    const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
    const coords = coordinates.map(Number);
</script>

  <div class="row">
    <!-- LEFT: Listing Details -->
    <div class="col-md-8">
      <div class="card" style="border: none;">
        <h3 style="font-weight: 600;"><%= listing.title %></h2>
          <img src="<%= listing.image.url %>" alt="listing_img" class="card-img-top show-img img-fluid rounded" style="object-fit: cover; height: 500px; max-width: 100%;">
          <h3 class="mt-3"><%= listing.shortDescription %></h3>
          <p class="card-para mt-2">
              <%= listing.detail %><br>
              <b> Price: £<%= listing.price %> for 1 night</b><br>
              <%= listing.location %> <br>
              <%= listing.country %> <br>
            </p>
            <div>
              <h5 style="font-weight: 600;">About this place</h5>
              <p class="card-para"><%= listing.about %></p>
            </div>

            <div class="col-12 col-lg-10 mb-3">
              <h3>Where you'll be</h3>
                <div id="map"></div>
            </div>
      </div>
    </div>

    <!-- RIGHT: Price Summary -->
    <div class="col-md-4 mt-4 mt-md-0">
      <div class="card p-4 mt-5 shadow-lg" style="border-radius: 5%;">
        <h4 class="mb-3">Booking Summary</h4>
        <p><strong>Check-in:</strong> <%= checkin %></p>
        <p><strong>Check-out:</strong> <%= checkout %></p>
        <p><strong>Guests:</strong> <%= guest %></p>
        <p><strong>Nights:</strong> <%= nights %></p>

        <div class="d-flex justify-content-between">
          <p>£<%= listing.price %> x <%= nights %> nights</p>
          <p>£<%= subtotal.toFixed(2) %></p>
        </div>

        <div class="d-flex justify-content-between">
          <p>Service Fee (15%)</p>
          <p>£<%= serviceFee.toFixed(2) %></p>
        </div>

        <hr>

        <div class="d-flex justify-content-between fw-bold">
          <p>Total</p>
          <p>£<%= total.toFixed(2) %></p>
        </div>

        <div class="d-flex w-100">
          <form action="/listings/<%= listing._id %>/book" method="POST" class="w-50 me-2">
            <input type="hidden" name="checkin" value="<%= checkin %>">
            <input type="hidden" name="checkout" value="<%= checkout %>">
            <input type="hidden" name="guest" value="<%= guest %>">
            <button type="submit" class="btn w-100" style="background-color: #fe424d; color: white;">Confirm Booking</button>
          </form>

          <form action="/listings/<%= listing._id %>" method="GET" class="w-50 ms-2">
            <button type="submit" class="btn btn-dark w-100" style="color: white;">Edit Booking</button>
          </form>
        </div>

      </div>
    </div>
    <script src="/js/map.js"></script>
  </div>
